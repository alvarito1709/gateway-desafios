# =============================================================================
# Aula Especializate · Desafíos — gateway LTI 1.3 (sitio estático protegido)
# Copiar a .env y completar. .env NO se sube al repositorio.
# =============================================================================

# --- Servidor ---------------------------------------------------------------
# Puerto local. En la VM: iniciación 3000, planillas 3001, desafíos 3002 (Nginx reenvía).
PORT=3002
NODE_ENV=production
# Solo el ORIGEN público (https://host), sin ruta.
PUBLIC_BASE_URL=https://especializate.bue.edu.ar
# Prefijo público de TODAS las rutas del gateway. Nginx lo reenvía sin modificarlo.
# Para desarrollo local sin prefijo, dejarlo vacío.
BASE_PATH=/aula/desafios
# Nombre de la cookie de sesión (default desafios_lti_sid). Va acotada a BASE_PATH.
#SESSION_COOKIE_NAME=desafios_lti_sid

# --- Sitio estático -----------------------------------------------------------
# Carpeta del proyecto desafios-especializate (absoluta en producción, o relativa a este repo).
#   Producción:  AULA_DIR=/var/www/desafios-especializate
#   Desarrollo:  AULA_DIR=../desafios-especializate
AULA_DIR=/var/www/desafios-especializate
# Página a la que se entra tras un launch válido (dentro de AULA_DIR).
#AULA_ENTRY=/index.html

# --- Sesión -----------------------------------------------------------------
# Cadena aleatoria de al menos 32 caracteres:  openssl rand -base64 48
SESSION_SECRET=
# Duración de la sesión en minutos (default 240).
#SESSION_TTL_MIN=240

# --- Moodle / LTI 1.3 (los da el Moodle del aula de egresados) ----------------
LTI_ISSUER=
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_AUTH_LOGIN_URL=
LTI_JWKS_URL=
#LTI_TOKEN_URL=
MOODLE_URL=
# Solo el aula de egresados: ids de curso (context.id del launch, el ?id= de la URL del
# curso en Moodle) separados por coma. Vacío = cualquier curso de ese Moodle.
#LTI_ALLOWED_CONTEXT_IDS=
# Opcionales: clave privada propia de la herramienta (si no, se genera en .keys/).
#LTI_TOOL_PRIVATE_KEY=
#LTI_TOOL_KID=
# Solo si Moodle abre el aula dentro de un iframe (requiere HTTPS).
#EMBED_IN_IFRAME=false

# --- Solo desarrollo (nunca en producción) -------------------------------------
# Simula un launch de Moodle en BASE_PATH/dev/launch.
#DEV_FAKE_LAUNCH=true
